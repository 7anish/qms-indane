NODE_ENV=development
PORT=5001

MONGO_URI=mongodb://127.0.0.1:27017/qms

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

CLIENT_URL=http://localhost:5173

# Used by `npm run seed:superadmin`
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@qms.com
SUPER_ADMIN_PASSWORD=Admin@123

# mock = do not send; save each email as a .eml file in backend/outbox (default)
# smtp = send for real using the SMTP_* settings below
MAIL_MODE=mock

# Outgoing email for quotations (e.g. Gmail: smtp.gmail.com, port 587, use an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="QMS <no-reply@example.com>"
